{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nullvector.local/schema/creature_stage_neural_physiology_evaluation.schema.json",
  "title": "NULLVECTOR prediction-fed physiology evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format", "status", "evaluation_source_sha256", "model_source_sha256",
    "checkpoint", "teacher", "scope", "thresholds", "clips", "aggregate",
    "families", "interventions", "diagnostics", "gates", "promotion_eligible",
    "semantic_sha256"
  ],
  "properties": {
    "format": {"const": "nullvector-creature-stage-neural-physiology-evaluation-v1"},
    "status": {"const": "evaluated"},
    "evaluation_source_sha256": {"$ref": "#/$defs/sha256"},
    "model_source_sha256": {"$ref": "#/$defs/sha256"},
    "checkpoint": {"type": "object"},
    "teacher": {"type": "object"},
    "scope": {"type": "object"},
    "thresholds": {"type": "object"},
    "clips": {"type": "array", "minItems": 5, "maxItems": 45},
    "aggregate": {"type": "object"},
    "families": {"type": "array", "minItems": 5, "maxItems": 5},
    "interventions": {"type": "array", "minItems": 1, "maxItems": 9},
    "diagnostics": {"type": "object"},
    "gates": {"type": "object"},
    "promotion_eligible": {"type": "boolean"},
    "semantic_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
