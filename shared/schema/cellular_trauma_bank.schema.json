{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nullvector cellular trauma bank",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "status", "quality_tier", "compiler", "source", "array_format", "heal_class_vocab", "identity_count", "total_cells", "total_bonds", "fragment_fate_counts", "identities", "contact_sheet", "runtime_contract", "gates", "semantic_sha256"],
  "properties": {
    "format": {"const": "nullvector-cellular-trauma-bank-v1"},
    "status": {"const": "ready"},
    "quality_tier": {"const": "connected-wound-clot-scar-fragment-fate-v1"},
    "compiler": {"type": "object", "additionalProperties": false, "required": ["source_sha256", "python_runtime_required"], "properties": {"source_sha256": {"$ref": "#/$defs/hash"}, "python_runtime_required": {"const": false}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["physiology_manifest", "physiology_manifest_sha256", "physiology_semantic_sha256", "physiology_validation", "anatomy_manifest_sha256"], "properties": {"physiology_manifest": {"type": "string", "pattern": "^[^\\\\]+$"}, "physiology_manifest_sha256": {"$ref": "#/$defs/hash"}, "physiology_semantic_sha256": {"$ref": "#/$defs/hash"}, "physiology_validation": {"type": "object"}, "anatomy_manifest_sha256": {"$ref": "#/$defs/hash"}}},
    "array_format": {"const": "nullvector-cellular-trauma-arrays-v1"},
    "heal_class_vocab": {"const": ["inert", "integument", "contractile", "vascular", "visceral", "neural", "stem_or_immune"]},
    "identity_count": {"const": 45},
    "total_cells": {"type": "integer", "minimum": 1},
    "total_bonds": {"type": "integer", "minimum": 1},
    "fragment_fate_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
    "identities": {"type": "array", "minItems": 45, "maxItems": 45, "items": {"$ref": "#/$defs/identity"}},
    "contact_sheet": {"$ref": "#/$defs/artifact"},
    "runtime_contract": {"type": "object", "minProperties": 10, "properties": {"python_runtime_required": {"const": false}}, "additionalProperties": {"const": true}},
    "gates": {"type": "object", "minProperties": 7, "additionalProperties": {"const": true}},
    "semantic_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256"], "properties": {"path": {"type": "string", "pattern": "^[^\\\\]+$"}, "bytes": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/hash"}}},
    "profile": {
      "type": "object", "additionalProperties": false,
      "required": ["family", "reconnect_window_seconds", "magnetic_radius_cells", "magnetic_strength", "clot_rate", "scar_rate", "regrowth_rate", "detached_fate", "polyp_min_cells", "cell_count", "bond_count", "healing_class_counts", "mean_clotting_weight", "mean_scar_bias", "mean_regrowth_weight"],
      "properties": {
        "family": {"enum": ["humanoid", "animalian", "plantlike", "anomaly", "machine"]},
        "reconnect_window_seconds": {"type": "number", "exclusiveMinimum": 0}, "magnetic_radius_cells": {"type": "number", "exclusiveMinimum": 0}, "magnetic_strength": {"type": "number", "exclusiveMinimum": 0}, "clot_rate": {"type": "number", "exclusiveMinimum": 0}, "scar_rate": {"type": "number", "exclusiveMinimum": 0}, "regrowth_rate": {"type": "number", "exclusiveMinimum": 0},
        "detached_fate": {"enum": ["biomass", "polyp", "phase_polyp", "module_polyp"]}, "polyp_min_cells": {"type": "integer", "minimum": 1}, "cell_count": {"type": "integer", "minimum": 1}, "bond_count": {"type": "integer", "minimum": 1},
        "healing_class_counts": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 0}},
        "mean_clotting_weight": {"type": "number", "minimum": 0, "maximum": 1}, "mean_scar_bias": {"type": "number", "minimum": 0, "maximum": 1}, "mean_regrowth_weight": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["sample_id", "ordinal", "family", "family_id", "source_anatomy_sha256", "source_physiology_sha256", "profile", "arrays_semantic_sha256", "arrays"],
      "properties": {"sample_id": {"type": "string", "minLength": 1}, "ordinal": {"type": "integer", "minimum": 0, "maximum": 44}, "family": {"type": "string"}, "family_id": {"type": "integer", "minimum": 0, "maximum": 4}, "source_anatomy_sha256": {"$ref": "#/$defs/hash"}, "source_physiology_sha256": {"$ref": "#/$defs/hash"}, "profile": {"$ref": "#/$defs/profile"}, "arrays_semantic_sha256": {"$ref": "#/$defs/hash"}, "arrays": {"$ref": "#/$defs/artifact"}}
    }
  }
}
