{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nullvector.local/schema/map_topology_neural_raw.schema.json",
  "title": "Raw neural topology proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "authority", "proposal_source", "source_sha256", "tensor_contract_sha256", "seed", "theme", "config", "points", "raw_topology_sha256", "arrays_sha256", "provenance", "raw_identity_sha256", "arrays"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_type": {"const": "raw_neural_topology"},
    "authority": {"const": "proposal_only_never_runtime"},
    "proposal_source": {"type": "string", "minLength": 1, "maxLength": 128},
    "source_sha256": {"$ref": "#/$defs/sha"},
    "tensor_contract_sha256": {"$ref": "#/$defs/sha"},
    "seed": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "theme": {"enum": ["arena", "rooms", "caves", "archipelago", "garden", "anomaly"]},
    "config": {"$ref": "#/$defs/config"},
    "points": {"$ref": "#/$defs/points"},
    "raw_topology_sha256": {"$ref": "#/$defs/sha"},
    "arrays_sha256": {"$ref": "#/$defs/sha"},
    "provenance": {"type": "object", "minProperties": 1, "maxProperties": 32},
    "raw_identity_sha256": {"$ref": "#/$defs/sha"},
    "arrays": {"$ref": "#/$defs/arrayArtifact"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "point": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 0, "maximum": 255}, {"type": "integer", "minimum": 0, "maximum": 255}], "items": false, "minItems": 2, "maxItems": 2},
    "points": {"type": "object", "additionalProperties": false, "required": ["start", "exit", "objectives", "spawns"], "properties": {"start": {"$ref": "#/$defs/point"}, "exit": {"$ref": "#/$defs/point"}, "objectives": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/point"}}, "spawns": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/point"}}}},
    "config": {"type": "object", "additionalProperties": false, "required": ["width", "height", "objective_count", "spawn_count", "min_start_exit_distance", "spawn_clearance_start", "spawn_clearance_objective", "spawn_clearance_hazard"], "properties": {"width": {"type": "integer", "minimum": 32, "maximum": 256}, "height": {"type": "integer", "minimum": 32, "maximum": 256}, "objective_count": {"type": "integer", "minimum": 1, "maximum": 12}, "spawn_count": {"type": "integer", "minimum": 0, "maximum": 256}, "min_start_exit_distance": {"type": "integer", "minimum": 0}, "spawn_clearance_start": {"type": "integer", "minimum": 0}, "spawn_clearance_objective": {"type": "integer", "minimum": 0}, "spawn_clearance_hazard": {"type": "integer", "minimum": 0}}},
    "member": {"type": "object", "additionalProperties": false, "required": ["dtype", "shape", "nbytes", "array_sha256"], "properties": {"dtype": {"type": "string"}, "shape": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1, "maximum": 256}}, "nbytes": {"type": "integer", "minimum": 1}, "array_sha256": {"$ref": "#/$defs/sha"}}},
    "arrayArtifact": {"type": "object", "additionalProperties": false, "required": ["file", "bytes", "sha256", "canonical_arrays_sha256", "members"], "properties": {"file": {"const": "raw_topology.npz"}, "bytes": {"type": "integer", "minimum": 1, "maximum": 2097152}, "sha256": {"$ref": "#/$defs/sha"}, "canonical_arrays_sha256": {"$ref": "#/$defs/sha"}, "members": {"type": "object", "additionalProperties": false, "required": ["terrain", "hazard", "elevation"], "properties": {"terrain": {"$ref": "#/$defs/member"}, "hazard": {"$ref": "#/$defs/member"}, "elevation": {"$ref": "#/$defs/member"}}}}}
  }
}
