{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nullvector.local/schema/creature_stage_motion_corpus.schema.json",
  "title": "NULLVECTOR action-conditioned cellular motion corpus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format", "passed", "fixed_hz", "frames_per_clip", "family_count",
    "chassis_count", "motion_count", "clip_count", "total_frames",
    "total_cell_samples", "motion_order", "motion_specs", "quantization",
    "control_contract", "contracts", "source", "corpus_identity_sha256",
    "artifacts", "chassis", "clips"
  ],
  "properties": {
    "format": {"const": "nullvector-creature-stage-motion-corpus-v1"},
    "passed": {"const": true},
    "fixed_hz": {"const": 30},
    "frames_per_clip": {"const": 72},
    "family_count": {"const": 5},
    "chassis_count": {"const": 20},
    "motion_count": {"const": 13},
    "clip_count": {"const": 260},
    "total_frames": {"const": 18720},
    "total_cell_samples": {"type": "integer", "minimum": 1000000, "maximum": 10000000},
    "motion_order": {"$ref": "#/$defs/motionOrder"},
    "motion_specs": {
      "type": "object", "minProperties": 13, "maxProperties": 13,
      "additionalProperties": {"$ref": "#/$defs/motionSpec"},
      "propertyNames": {"enum": ["idle_breathe", "idle_wiggle", "locomote", "joy", "anger", "fear", "confused", "sleep", "taunt", "attack", "cast", "hit", "death"]}
    },
    "quantization": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "components", "scale", "bias", "clipped_values", "minimum_encoded", "maximum_encoded"],
      "properties": {
        "format": {"const": "position-delta-u16le-biased-v1"},
        "components": {"type": "array", "prefixItems": [{"const": "x"}, {"const": "y"}], "minItems": 2, "maxItems": 2},
        "scale": {"const": 256},
        "bias": {"const": 32768},
        "clipped_values": {"const": 0},
        "minimum_encoded": {"type": "integer", "minimum": 29184, "maximum": 32768},
        "maximum_encoded": {"type": "integer", "minimum": 32768, "maximum": 36352}
      }
    },
    "control_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["move", "aim", "attack", "utility", "external_event"],
      "properties": {
        "move": {"const": "unit-disk-vec2"},
        "aim": {"const": "normalized-vec2"},
        "attack": {"const": "unit-scalar"},
        "utility": {"const": "unit-scalar"},
        "external_event": {"type": "array", "prefixItems": [{"const": "none"}, {"const": "impact"}, {"const": "terminal"}], "minItems": 3, "maxItems": 3}
      }
    },
    "contracts": {
      "type": "object", "additionalProperties": false,
      "required": ["morphology", "motion", "orientation", "binary"],
      "properties": {
        "morphology": {"const": "coordinate-conditioned-safe-scaffold-v1"},
        "motion": {"const": "layered-cellular-motion-13x20-v1"},
        "orientation": {"const": "vertical-locked-2.5d-v1"},
        "binary": {"const": "clip-major-frame-major-cell-major-xy-u16le-v1"}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["files", "combined_sha256"],
      "properties": {
        "files": {
          "type": "object", "additionalProperties": false,
          "required": ["scripts/creature_stage/creature_neural.gd", "scripts/creature_stage/neural_creature.gd", "scripts/creature_stage/motion_corpus.gd"],
          "properties": {
            "scripts/creature_stage/creature_neural.gd": {"$ref": "#/$defs/sha256"},
            "scripts/creature_stage/neural_creature.gd": {"$ref": "#/$defs/sha256"},
            "scripts/creature_stage/motion_corpus.gd": {"$ref": "#/$defs/sha256"}
          }
        },
        "combined_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "corpus_identity_sha256": {"$ref": "#/$defs/sha256"},
    "artifacts": {
      "type": "object", "additionalProperties": false,
      "required": ["motion_frames"],
      "properties": {
        "motion_frames": {
          "type": "object", "additionalProperties": false,
          "required": ["path", "bytes", "sha256"],
          "properties": {
            "path": {"const": "motion_frames.u16le"},
            "bytes": {"type": "integer", "minimum": 4000000, "maximum": 40000000, "multipleOf": 4},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "chassis": {"type": "array", "minItems": 20, "maxItems": 20, "items": {"$ref": "#/$defs/chassis"}},
    "clips": {"type": "array", "minItems": 260, "maxItems": 260, "items": {"$ref": "#/$defs/clip"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "vec2": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
    "motionOrder": {
      "type": "array", "minItems": 13, "maxItems": 13,
      "prefixItems": [{"const": "idle_breathe"}, {"const": "idle_wiggle"}, {"const": "locomote"}, {"const": "joy"}, {"const": "anger"}, {"const": "fear"}, {"const": "confused"}, {"const": "sleep"}, {"const": "taunt"}, {"const": "attack"}, {"const": "cast"}, {"const": "hit"}, {"const": "death"}]
    },
    "motionSpec": {
      "type": "object", "additionalProperties": false,
      "required": ["cycle", "loop", "priority"],
      "properties": {
        "cycle": {"type": "number", "exclusiveMinimum": 0, "maximum": 3},
        "loop": {"type": "boolean"},
        "priority": {"type": "integer", "minimum": 0, "maximum": 5}
      }
    },
    "genes": {
      "type": "object", "additionalProperties": false,
      "required": ["width", "height", "asymmetry", "symmetry", "repair", "metabolism", "fertility", "bond_strength"],
      "properties": {
        "width": {"type": "number", "minimum": 0.5, "maximum": 1.5},
        "height": {"type": "number", "minimum": 0.5, "maximum": 1.5},
        "asymmetry": {"type": "number", "minimum": -0.3, "maximum": 0.3},
        "symmetry": {"type": "number", "minimum": 0.45, "maximum": 1},
        "repair": {"type": "number", "minimum": 0.4, "maximum": 1.6},
        "metabolism": {"type": "number", "minimum": 0.4, "maximum": 1.6},
        "fertility": {"type": "number", "minimum": 0.4, "maximum": 1.6},
        "bond_strength": {"type": "number", "minimum": 0.4, "maximum": 1.6}
      }
    },
    "cell": {
      "type": "object", "additionalProperties": false,
      "required": ["grid", "tissue", "organ", "appendage", "side", "initial_health_q"],
      "properties": {
        "grid": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": -32, "maximum": 32}},
        "tissue": {"enum": ["skin", "structure", "armor", "neural", "circulatory", "respiratory", "digestive", "sensor", "locomotor", "storage", "phase", "root", "weapon"]},
        "organ": {"enum": ["none", "brain", "heart", "lung", "gut", "eye", "root", "stem", "bulb", "frond", "runner", "meristem", "vascular", "photoreceptor", "core", "orbital", "phase_bond", "phase_brain", "singularity", "flux", "transmuter", "drive", "mast", "hardpoint", "processor", "coolant_pump", "radiator", "battery", "optic"]},
        "appendage": {"type": "integer", "minimum": -1, "maximum": 31},
        "side": {"type": "integer", "minimum": -1, "maximum": 1},
        "initial_health_q": {"type": "integer", "minimum": 0, "maximum": 255}
      }
    },
    "chassis": {
      "type": "object", "additionalProperties": false,
      "required": ["chassis_id", "family", "family_id", "morphotype", "morphotype_id", "seed", "generation", "genes", "cell_count", "cell_identity_sha256", "cells"],
      "properties": {
        "chassis_id": {"type": "integer", "minimum": 0, "maximum": 19},
        "family": {"enum": ["humanoid", "animalian", "plantlike", "anomaly", "machine"]},
        "family_id": {"type": "integer", "minimum": 0, "maximum": 4},
        "morphotype": {"enum": ["balanced", "longarm", "sixlimb", "crowned", "quadruped", "crawler", "longtail", "horned", "treeform", "rosette", "runner", "twin_stem", "triad", "cross", "pentad", "halo", "tracked", "walker", "hover", "crab"]},
        "morphotype_id": {"type": "integer", "minimum": 0, "maximum": 3},
        "seed": {"type": "integer"},
        "generation": {"const": 0},
        "genes": {"$ref": "#/$defs/genes"},
        "cell_count": {"type": "integer", "minimum": 70, "maximum": 500},
        "cell_identity_sha256": {"$ref": "#/$defs/sha256"},
        "cells": {"type": "array", "minItems": 70, "maxItems": 500, "items": {"$ref": "#/$defs/cell"}}
      }
    },
    "controls": {
      "type": "object", "additionalProperties": false,
      "required": ["move", "aim", "attack", "utility", "external_event"],
      "properties": {
        "move": {"$ref": "#/$defs/vec2"},
        "aim": {"$ref": "#/$defs/vec2"},
        "attack": {"type": "number", "minimum": 0, "maximum": 1},
        "utility": {"type": "number", "minimum": 0, "maximum": 1},
        "external_event": {"enum": ["none", "impact", "terminal"]}
      }
    },
    "clip": {
      "type": "object", "additionalProperties": false,
      "required": ["clip_id", "chassis_id", "family_id", "morphotype_id", "motion", "motion_id", "frames", "cell_count", "frame_stride_bytes", "byte_offset", "byte_length", "trajectory_sha256", "controls"],
      "properties": {
        "clip_id": {"type": "integer", "minimum": 0, "maximum": 259},
        "chassis_id": {"type": "integer", "minimum": 0, "maximum": 19},
        "family_id": {"type": "integer", "minimum": 0, "maximum": 4},
        "morphotype_id": {"type": "integer", "minimum": 0, "maximum": 3},
        "motion": {"enum": ["idle_breathe", "idle_wiggle", "locomote", "joy", "anger", "fear", "confused", "sleep", "taunt", "attack", "cast", "hit", "death"]},
        "motion_id": {"type": "integer", "minimum": 0, "maximum": 12},
        "frames": {"const": 72},
        "cell_count": {"type": "integer", "minimum": 70, "maximum": 500},
        "frame_stride_bytes": {"type": "integer", "minimum": 280, "maximum": 2000, "multipleOf": 4},
        "byte_offset": {"type": "integer", "minimum": 0, "maximum": 40000000, "multipleOf": 4},
        "byte_length": {"type": "integer", "minimum": 20160, "maximum": 144000, "multipleOf": 4},
        "trajectory_sha256": {"$ref": "#/$defs/sha256"},
        "controls": {"$ref": "#/$defs/controls"}
      }
    }
  }
}
