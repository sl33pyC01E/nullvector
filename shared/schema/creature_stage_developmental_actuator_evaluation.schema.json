{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nullvector.local/schema/creature-stage-developmental-actuator-evaluation-v1.json",
  "type": "object", "additionalProperties": false,
  "required": ["format", "status", "source_sha256", "production", "checkpoint", "teacher_semantic_sha256", "device", "specimens", "metrics", "gates", "contact_sheet", "semantic_sha256"],
  "properties": {
    "format": {"const": "nullvector-creature-stage-developmental-actuator-evaluation-v1"},
    "status": {"enum": ["passed", "failed-quality"]}, "source_sha256": {"$ref": "#/$defs/sha256"},
    "production": {"type": "object"}, "checkpoint": {"type": "object"},
    "teacher_semantic_sha256": {"$ref": "#/$defs/sha256"}, "device": {"type": "string"},
    "specimens": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"type": "object"}},
    "metrics": {"type": "object"},
    "gates": {"type": "object", "minProperties": 12, "additionalProperties": {"type": "boolean"}},
    "contact_sheet": {"type": "object"}, "semantic_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
