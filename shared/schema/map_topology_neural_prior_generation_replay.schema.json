{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nullvector.local/schema/map_topology_neural_prior_generation_replay.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["format", "source_sha256", "config_sha256", "case_count", "exact_case_count", "attempts", "native_failures", "case_results", "gates", "replay_sha256"],
  "properties": {
    "format": {"const": "nullvector-neural-map-topology-prior-generation-replay/1.0.0"}, "source_sha256": {"$ref": "#/$defs/sha"}, "config_sha256": {"$ref": "#/$defs/sha"},
    "case_count": {"type": "integer", "minimum": 1, "maximum": 192}, "exact_case_count": {"type": "integer", "minimum": 1, "maximum": 192}, "attempts": {"type": "integer", "minimum": 1, "maximum": 576}, "native_failures": {"type": "integer", "minimum": 0, "maximum": 576},
    "case_results": {"type": "array", "minItems": 1, "maxItems": 192, "items": {"type": "object", "additionalProperties": false, "required": ["case_id", "case_identity_sha256", "raw_topology_sha256", "compiled_arrays_sha256", "exact"], "properties": {"case_id": {"type": "string"}, "case_identity_sha256": {"$ref": "#/$defs/sha"}, "raw_topology_sha256": {"$ref": "#/$defs/sha"}, "compiled_arrays_sha256": {"$ref": "#/$defs/sha"}, "exact": {"const": true}}}},
    "gates": {"type": "object", "additionalProperties": false, "required": ["all_cases_exact", "all_raw_artifacts_exact", "all_compiled_artifacts_exact", "all_neural_samples_exact", "all_previews_exact"], "properties": {"all_cases_exact": {"const": true}, "all_raw_artifacts_exact": {"const": true}, "all_compiled_artifacts_exact": {"const": true}, "all_neural_samples_exact": {"const": true}, "all_previews_exact": {"const": true}}},
    "replay_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {"sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
