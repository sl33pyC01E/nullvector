{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nullvector.local/schema/cellular_nca_manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "status", "source_sha256", "model", "parameter_count", "training", "provenance", "evaluation", "visual", "gates", "limitations", "manifest_sha256"],
  "properties": {
    "format": {"const": "nullvector-organism-neural-cellular-automaton-v1"},
    "status": {"enum": ["ready", "experimental"]},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "model": {"type": "object"},
    "parameter_count": {"type": "integer", "minimum": 1000000},
    "training": {"type": "object"},
    "provenance": {
      "type": "object",
      "required": ["corpus_manifest_sha256", "training_contract_sha256", "checkpoint_path", "checkpoint_sha256", "model_state_sha256", "ema_state_sha256"]
    },
    "evaluation": {"type": "object"},
    "visual": {
      "type": "object",
      "required": ["path", "bytes", "sha256", "visually_inspected"],
      "properties": {
        "path": {"const": "cellular_dynamics_rollout.png"},
        "bytes": {"type": "integer", "minimum": 100},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "visually_inspected": {"type": "boolean"}
      }
    },
    "gates": {
      "type": "object",
      "minProperties": 8,
      "additionalProperties": {"type": "boolean"}
    },
    "limitations": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 8}},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
