{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nullvector developmental muscle-causal production v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "source_sha256", "teacher", "prior", "v1_seed", "model", "training", "seed", "total_updates", "segment_updates", "batch_size", "optimizer", "ema_decay", "precision", "minimum_free_vram_bytes", "minimum_free_disk_bytes", "semantic_sha256"],
  "properties": {
    "format": {"const": "nullvector-developmental-muscle-causal-production-v2"},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "teacher": {"$ref": "#/$defs/authority"},
    "prior": {"$ref": "#/$defs/authority"},
    "v1_seed": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "update", "ema_state_sha256", "contract_semantic_sha256", "transferred_tensors"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "update": {"const": 2000},
        "ema_state_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "contract_semantic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "transferred_tensors": {"type": "integer", "minimum": 1}
      }
    },
    "model": {"type": "object", "minProperties": 11, "additionalProperties": {"type": ["integer", "number"]}},
    "training": {"type": "object", "minProperties": 19, "additionalProperties": {"type": ["integer", "number"]}},
    "seed": {"type": "integer", "minimum": 0},
    "total_updates": {"type": "integer", "minimum": 500, "maximum": 10000},
    "segment_updates": {"type": "integer", "minimum": 50, "maximum": 250},
    "batch_size": {"type": "integer", "minimum": 5, "maximum": 20},
    "optimizer": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "lr", "weight_decay", "warmup_updates", "gradient_clip"],
      "properties": {
        "name": {"const": "AdamW"}, "lr": {"type": "number", "exclusiveMinimum": 0},
        "weight_decay": {"type": "number", "minimum": 0},
        "warmup_updates": {"type": "integer", "minimum": 1},
        "gradient_clip": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "ema_decay": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "precision": {"const": "bf16-autocast-float32-loss"},
    "minimum_free_vram_bytes": {"type": "integer", "minimum": 4294967296},
    "minimum_free_disk_bytes": {"type": "integer", "minimum": 107374182400},
    "semantic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "semantic_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "semantic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
