{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nullvector.local/schema/creature_stage_neural_motion_evaluation.schema.json",
  "title": "NULLVECTOR prediction-fed cellular motion evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format", "status", "evaluation_source_sha256", "model_source_sha256",
    "checkpoint", "teacher", "scope", "replay_policy", "thresholds", "clips", "aggregate",
    "families", "motions", "diagnostics", "gates", "promotion_eligible",
    "semantic_sha256"
  ],
  "properties": {
    "format": {"const": "nullvector-creature-stage-neural-motion-evaluation-v2"},
    "status": {"const": "evaluated"},
    "evaluation_source_sha256": {"$ref": "#/$defs/sha256"},
    "model_source_sha256": {"$ref": "#/$defs/sha256"},
    "checkpoint": {"type": "object"},
    "teacher": {"type": "object"},
    "scope": {"type": "object"},
    "replay_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "structure", "provenance_and_gates", "numeric_comparison",
        "absolute_tolerance", "relative_tolerance", "reference_backend"
      ],
      "properties": {
        "structure": {"const": "exact"},
        "provenance_and_gates": {"const": "exact"},
        "numeric_comparison": {"const": "symmetric_isclose"},
        "absolute_tolerance": {"const": 0.00005},
        "relative_tolerance": {"const": 0.00002},
        "reference_backend": {"const": "cpu"}
      }
    },
    "thresholds": {"type": "object"},
    "clips": {"type": "array", "minItems": 5, "maxItems": 65},
    "aggregate": {"$ref": "#/$defs/metrics"},
    "families": {"type": "array", "minItems": 5, "maxItems": 5},
    "motions": {"type": "array", "minItems": 1, "maxItems": 13},
    "diagnostics": {"type": "object"},
    "gates": {"type": "object"},
    "promotion_eligible": {"type": "boolean"},
    "semantic_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position_mae_px", "velocity_mae_px", "copy_previous_mae_px",
        "baseline_improvement", "graph_relative_mae_px", "predicted_energy_px",
        "target_energy_px", "energy_ratio", "appendage_energy_px",
        "core_energy_px", "appendage_core_ratio", "loop_closure_px",
        "max_displacement_px"
      ],
      "properties": {
        "position_mae_px": {"type": "number"},
        "velocity_mae_px": {"type": "number"},
        "copy_previous_mae_px": {"type": "number"},
        "baseline_improvement": {"type": "number"},
        "graph_relative_mae_px": {"type": "number"},
        "predicted_energy_px": {"type": "number"},
        "target_energy_px": {"type": "number"},
        "energy_ratio": {"type": "number"},
        "appendage_energy_px": {"type": "number"},
        "core_energy_px": {"type": "number"},
        "appendage_core_ratio": {"type": "number"},
        "loop_closure_px": {"type": "number"},
        "max_displacement_px": {"type": "number"}
      }
    }
  }
}
