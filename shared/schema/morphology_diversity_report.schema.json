{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nullvector neural morphology structural diversity report",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "status", "audit_source_sha256", "input", "feature_contract", "records", "classification", "aggregate", "gates", "interpretation", "report_sha256"],
  "properties": {
    "format": {"const": "nullvector-neural-morphology-structural-diversity-v1"},
    "status": {"const": "ready"},
    "audit_source_sha256": {"$ref": "#/$defs/hash"},
    "input": {"type": "object", "additionalProperties": false, "required": ["generation_manifest_path", "generation_manifest_sha256", "generation_manifest_bytes"], "properties": {"generation_manifest_path": {"type": "string", "minLength": 1}, "generation_manifest_sha256": {"$ref": "#/$defs/hash"}, "generation_manifest_bytes": {"type": "integer", "minimum": 1}}},
    "feature_contract": {"type": "object", "additionalProperties": false, "required": ["names", "normalized_grid", "basic_quantization_step", "sha256"], "properties": {"names": {"type": "array", "minItems": 154, "maxItems": 154, "uniqueItems": true, "items": {"type": "string"}}, "normalized_grid": {"const": [12, 12]}, "basic_quantization_step": {"const": 0.02}, "sha256": {"$ref": "#/$defs/hash"}}},
    "records": {"type": "array", "minItems": 80, "maxItems": 80, "items": {"$ref": "#/$defs/record"}},
    "classification": {"type": "object", "additionalProperties": false, "required": ["family", "subtype", "role"], "properties": {"family": {"$ref": "#/$defs/classification"}, "subtype": {"$ref": "#/$defs/classification"}, "role": {"$ref": "#/$defs/classification"}}},
    "aggregate": {"type": "object", "required": ["sample_count", "feature_count", "unique_coarse_chassis_count", "coarse_chassis_unique_fraction", "horizontal_symmetry", "vertical_symmetry", "appendage_fraction", "per_family"]},
    "gates": {"type": "object", "minProperties": 7, "additionalProperties": {"const": true}},
    "interpretation": {"type": "object", "additionalProperties": false, "required": ["hard_gate_scope", "diagnostic_scope", "symmetry_is_hard_requirement"], "properties": {"hard_gate_scope": {"type": "string"}, "diagnostic_scope": {"type": "string"}, "symmetry_is_hard_requirement": {"const": false}}},
    "report_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "summary": {"type": "object", "additionalProperties": false, "required": ["minimum", "median", "mean", "maximum"], "properties": {"minimum": {"type": "number"}, "median": {"type": "number"}, "mean": {"type": "number"}, "maximum": {"type": "number"}}},
    "prediction": {"type": "object", "additionalProperties": false, "required": ["predicted_id", "predicted_name", "correct", "true_margin"], "properties": {"predicted_id": {"type": "integer", "minimum": 0}, "predicted_name": {"type": "string"}, "correct": {"type": "boolean"}, "true_margin": {"type": "number"}}},
    "classification": {"type": "object", "additionalProperties": false, "required": ["class_count", "retained_feature_count", "leave_one_out_accuracy", "true_margin", "per_class", "confusion"], "properties": {"class_count": {"type": "integer", "minimum": 2}, "retained_feature_count": {"type": "integer", "minimum": 1, "maximum": 154}, "leave_one_out_accuracy": {"type": "number", "minimum": 0, "maximum": 1}, "true_margin": {"$ref": "#/$defs/summary"}, "per_class": {"type": "array", "minItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["id", "name", "count", "correct", "recall"], "properties": {"id": {"type": "integer", "minimum": 0}, "name": {"type": "string"}, "count": {"type": "integer", "minimum": 1}, "correct": {"type": "integer", "minimum": 0}, "recall": {"type": "number", "minimum": 0, "maximum": 1}}}}, "confusion": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["true_id", "predicted_id", "count"], "properties": {"true_id": {"type": "integer", "minimum": 0}, "predicted_id": {"type": "integer", "minimum": 0}, "count": {"type": "integer", "minimum": 1}}}}}},
    "record": {"type": "object", "additionalProperties": false, "required": ["sample_id", "ordinal", "family_id", "family", "subtype_id", "subtype", "role_id", "role", "categorical_sha256", "coarse_chassis_sha256", "feature_values", "metrics", "classification"], "properties": {"sample_id": {"type": "string", "minLength": 1}, "ordinal": {"type": "integer", "minimum": 0, "maximum": 79}, "family_id": {"type": "integer", "minimum": 0, "maximum": 4}, "family": {"type": "string"}, "subtype_id": {"type": "integer", "minimum": 0, "maximum": 19}, "subtype": {"type": "string"}, "role_id": {"type": "integer", "minimum": 0, "maximum": 7}, "role": {"type": "string"}, "categorical_sha256": {"$ref": "#/$defs/hash"}, "coarse_chassis_sha256": {"$ref": "#/$defs/hash"}, "feature_values": {"type": "array", "minItems": 154, "maxItems": 154, "items": {"type": "number"}}, "metrics": {"type": "object", "additionalProperties": false, "required": ["solid_pixels", "bbox", "horizontal_symmetry", "vertical_symmetry", "appendage_fraction", "arm_pair_balance", "leg_pair_balance"], "properties": {"solid_pixels": {"type": "integer", "minimum": 1}, "bbox": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer"}}, "horizontal_symmetry": {"type": "number", "minimum": 0, "maximum": 1}, "vertical_symmetry": {"type": "number", "minimum": 0, "maximum": 1}, "appendage_fraction": {"type": "number", "minimum": 0, "maximum": 1}, "arm_pair_balance": {"type": "number", "minimum": 0, "maximum": 1}, "leg_pair_balance": {"type": "number", "minimum": 0, "maximum": 1}}}, "classification": {"type": "object", "additionalProperties": false, "required": ["family", "subtype", "role"], "properties": {"family": {"$ref": "#/$defs/prediction"}, "subtype": {"$ref": "#/$defs/prediction"}, "role": {"$ref": "#/$defs/prediction"}}}}}
  }
}
