{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NULLVECTOR loop-aware neural motion evaluation",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "status", "evaluation_source_sha256", "production_source_sha256", "loop_source_sha256", "rollout_source_sha256", "checkpoint", "teacher", "scope", "replay_policy", "thresholds", "clips", "aggregate", "families", "motions", "diagnostics", "gates", "promotion_eligible", "semantic_sha256"],
  "properties": {
    "format": {"const": "nullvector-creature-stage-neural-motion-loop-evaluation-v1"},
    "status": {"const": "evaluated"},
    "evaluation_source_sha256": {"$ref": "#/$defs/sha256"},
    "production_source_sha256": {"$ref": "#/$defs/sha256"},
    "loop_source_sha256": {"$ref": "#/$defs/sha256"},
    "rollout_source_sha256": {"$ref": "#/$defs/sha256"},
    "checkpoint": {"type": "object"},
    "teacher": {"type": "object"},
    "scope": {"type": "object"},
    "replay_policy": {"type": "object"},
    "thresholds": {"type": "object"},
    "clips": {"type": "array", "minItems": 5, "maxItems": 65},
    "aggregate": {"type": "object"},
    "families": {"type": "array", "minItems": 5, "maxItems": 5},
    "motions": {"type": "array", "minItems": 1, "maxItems": 13},
    "diagnostics": {"type": "object"},
    "gates": {"type": "object"},
    "promotion_eligible": {"type": "boolean"},
    "semantic_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
